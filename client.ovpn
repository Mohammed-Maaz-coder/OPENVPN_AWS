client
dev tun
proto udp

# Replace with your server public IP
remote YOUR_SERVER_IP 1194

resolv-retry infinite
nobind

persist-key
persist-tun

# Certificates
ca ca.crt
cert client.crt
key client.key
tls-auth ta.key 1

# Security
cipher AES-256-CBC
auth SHA256

remote-cert-tls server
verb 3